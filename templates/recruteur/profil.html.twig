{% extends 'base.html.twig' %}

{% block title %}Mon Profil Entreprise - TinderNance{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/profil_etudiant.css') }}">
{% endblock %}

{% block header %}{% endblock %}

{% block main %}
{# =========================================================================
   TOP NAVIGATION BAR
   ========================================================================= #}
<nav class="pe-navbar">
    <a href="{{ path('app_home') }}" class="brand-logo" style="text-decoration: none;">
        <div class="brand-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
        </div>
        <span>Tinder<span class="highlight">nance</span></span>
    </a>

    <div class="pe-nav-links">
        <a href="#" class="pe-nav-link">Offres</a>
        <a href="#" class="pe-nav-link">Candidats</a>
        <a href="#" class="pe-nav-link"></a>
        <a href="{{ path('app_recruteur_profil') }}" class="pe-nav-link active">Mon Profil &amp; Vitrine</a>
    </div>

    <div class="pe-nav-user-area">

        <div class="pe-nav-user-pill">
            {% set navAvatar = dto.logoUrl ? dto.logoUrl : asset('images/recruiter_avatar.jpeg') %}
            <img src="{{ navAvatar }}" alt="Avatar" class="pe-nav-user-avatar" onerror="this.src='{{ asset('images/recruiter_avatar.jpeg') }}';">
            <div class="pe-nav-user-meta">
                <p class="pe-nav-user-name">{{ dto.contactName ?: (app.user ? app.user.firstName ~ ' ' ~ app.user.lastName : 'Recruteur') }}</p>
                <p class="pe-nav-user-role">Recruteur</p>
            </div>
        </div>

        <a href="{{ path('app_logout') }}" class="pe-nav-link" style="color: var(--color-secondary); font-weight: 600;" title="Déconnexion">
            Déconnexion
        </a>
    </div>
</nav>

{# =========================================================================
   MAIN CONTENT
   ========================================================================= #}
<div class="pe-page-body">
    
    {# Flash messages feedback #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="pe-alert pe-alert-{{ label }}">
                <span>{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}

    {# Header Row with View Switcher #}
    <header class="pe-header-row">
        <div class="pe-header-left">
            <div class="pe-session-tag">
                <span class="pe-session-dot"></span>
                <span>ESPACE RECRUTEUR • SESSION ACTIVE</span>
            </div>
            <h1 class="pe-header-title">Mon Profil Entreprise</h1>
        </div>

        <!-- <div class="pe-view-switcher">
            <button type="button" class="pe-view-btn active" data-action="click->recruteur#switchView" data-recruteur-target="viewBtn">
                <img src="{{ asset('icons/edit_pen.svg') }}" alt="" width="14" height="14">
                <span>Éditer en tant qu'Entreprise</span>
            </button>
            <button type="button" class="pe-view-btn" data-action="click->recruteur#switchView" data-recruteur-target="viewBtn">
                <img src="{{ asset('icons/preview_eye.svg') }}" alt="" width="16" height="12">
                <span>Aperçu public Alternant</span>
            </button>
        </div> -->
    </header>

    {# Formulaire interactif relié au contrôleur Stimulus #}
    {{ form_start(form, {'attr': {'class': 'pe-split-grid', 'data-controller': 'recruteur'}, 'enctype': 'multipart/form-data'}) }}
        
        {# Champs cachés pour l'effectif et l'état de pause #}
        {{ form_widget(form.employeeCount, {'attr': {'data-recruteur-target': 'countHiddenInput'}}) }}
        {{ form_widget(form.isPaused, {'attr': {'data-recruteur-target': 'isPausedInput'}}) }}

        {# Champ fichier logo caché (déclenché via Stimulus) #}
        {{ form_widget(form.logoFile, {'attr': {'class': 'd-none', 'style': 'display:none;', 'data-recruteur-target': 'fileInput', 'data-action': 'change->recruteur#onLogoSelected', 'accept': 'image/*'}}) }}

        {# =====================================================================
           LEFT COLUMN: FORMULAIRE INTERACTIF (7 COLS)
           ===================================================================== #}
        <div class="pe-form-col">
            
            {# -----------------------------------------------------------------
               CARD 1: Identité & Coordonnées de l'Entreprise (Étape 1 sur 3)
               ----------------------------------------------------------------- #}
            <section class="pe-card">
                <div class="pe-card-header">
                    <div class="pe-card-title-wrap">
                        <img src="{{ asset('icons/identity_user.svg') }}" alt="" width="20" height="20">
                        <h2 class="pe-card-title">Identité &amp; Coordonnées</h2>
                    </div>
                    <span class="pe-card-step-badge">Étape 1 sur 3</span>
                </div>

                <div class="pe-identity-profile-row">
                    <div class="pe-avatar-box">
                        {% set companyLogo = dto.logoUrl ? dto.logoUrl : asset('images/company_logo.jpeg') %}
                        <img src="{{ companyLogo }}" alt="Logo" class="pe-avatar-photo" data-recruteur-target="avatarImg" onerror="this.src='{{ asset('images/company_logo.jpeg') }}';">
                        <button type="button" class="pe-avatar-change-btn" title="Changer le logo" data-action="click->recruteur#triggerLogoUpload">
                            <img src="{{ asset('icons/camera.svg') }}" alt="" width="13" height="12">
                        </button>
                    </div>

                    <div class="pe-identity-profile-info">
                        <div class="pe-identity-name-row">
                            <h3 class="pe-identity-name" data-recruteur-target="previewName">{{ dto.companyName }}</h3>
                            <img src="{{ asset('icons/verified_check.svg') }}" alt="Vérifié" width="18" height="18">
                        </div>
                        <p class="pe-identity-status-desc">
                            Compte entreprise vérifié • Recherche active de talents en contrat d'alternance.
                        </p>
                        <div class="pe-identity-actions">
                            <button type="button" class="pe-btn-mini pe-btn-mini-primary" data-action="click->recruteur#triggerLogoUpload">Changer le logo</button>
                            <button type="button" class="pe-btn-mini pe-btn-mini-muted">Supprimer</button>
                        </div>
                    </div>
                </div>

                <div class="pe-fields-row">
                    <div class="pe-form-group">
                        <label class="pe-label">Nom de l'entreprise</label>
                        {{ form_widget(form.companyName, {
                            'attr': {
                                'class': 'pe-input',
                                'placeholder': 'ex: Acme Technologies',
                                'data-recruteur-target': 'companyNameInput',
                                'data-action': 'input->recruteur#updateName'
                            }
                        }) }}
                        {{ form_errors(form.companyName) }}
                    </div>
                    <div class="pe-form-group">
                        <label class="pe-label">Email professionnel de contact</label>
                        {{ form_widget(form.email, {
                            'attr': {
                                'class': 'pe-input',
                                'placeholder': 'recrutement@entreprise.com'
                            }
                        }) }}
                        {{ form_errors(form.email) }}
                    </div>
                </div>

                <div class="pe-fields-row">
                    <div class="pe-form-group">
                        <label class="pe-label">Nom du recruteur / Responsable RH</label>
                        <div class="pe-input-icon-wrap">
                            <img src="{{ asset('icons/identity_user.svg') }}" alt="" width="14" height="14" class="pe-input-icon">
                            {{ form_widget(form.contactName, {
                                'attr': {
                                    'class': 'pe-input pe-input-with-icon',
                                    'placeholder': 'Prénom Nom'
                                }
                            }) }}
                        </div>
                        {{ form_errors(form.contactName) }}
                    </div>
                    <div class="pe-form-group">
                        <label class="pe-label">Secteur d'activité</label>
                        <div class="pe-input-icon-wrap">
                            <img src="{{ asset('icons/briefcase_doc.svg') }}" alt="" width="14" height="14" class="pe-input-icon">
                            {{ form_widget(form.sector, {
                                'attr': {
                                    'class': 'pe-input pe-input-with-icon',
                                    'placeholder': 'ex: Fintech, E-commerce, SaaS B2B...',
                                    'data-recruteur-target': 'sectorInput',
                                    'data-action': 'input->recruteur#updateSector'
                                }
                            }) }}
                        </div>
                        {{ form_errors(form.sector) }}
                    </div>
                </div>
            </section>

            {# -----------------------------------------------------------------
               CARD 2: Structure & Taille de l'Entreprise (Étape 2 sur 3)
               ----------------------------------------------------------------- #}
            <section class="pe-card">
                <div class="pe-card-header">
                    <div class="pe-card-title-wrap">
                        <img src="{{ asset('icons/school_cap.svg') }}" alt="" width="20" height="20">
                        <h2 class="pe-card-title">Structure &amp; Équipe</h2>
                    </div>
                    <span class="pe-card-step-badge">Étape 2 sur 3</span>
                </div>

                <div class="pe-form-group">
                    <label class="pe-label">Sélectionnez la tranche d'effectif de votre organisation :</label>
                    <div class="pe-rhythm-grid">
                        <div class="pe-rhythm-card {% if dto.employeeCount == '1-10' %}active{% endif %}"
                             data-action="click->recruteur#selectCount"
                             data-recruteur-target="countPill"
                             data-count-value="1-10"
                             data-count-label="1-10 collaborateurs">
                            <img src="{{ asset(dto.employeeCount == '1-10' ? 'icons/radio_checked.svg' : 'icons/radio_unchecked.svg') }}" alt="" width="18" height="18" class="pe-rhythm-radio-icon">
                            <div class="pe-rhythm-card-content">
                                <p class="pe-rhythm-title">1 – 10 collaborateurs</p>
                                <p class="pe-rhythm-desc">Startup &amp; TPE • Équipe agile à taille humaine</p>
                            </div>
                        </div>

                        <div class="pe-rhythm-card {% if dto.employeeCount == '11-49' %}active{% endif %}"
                             data-action="click->recruteur#selectCount"
                             data-recruteur-target="countPill"
                             data-count-value="11-49"
                             data-count-label="11-49 collaborateurs">
                            <img src="{{ asset(dto.employeeCount == '11-49' ? 'icons/radio_checked.svg' : 'icons/radio_unchecked.svg') }}" alt="" width="18" height="18" class="pe-rhythm-radio-icon">
                            <div class="pe-rhythm-card-content">
                                <p class="pe-rhythm-title">11 – 49 collaborateurs</p>
                                <p class="pe-rhythm-desc">PME innovante • Proximité &amp; projets transverses</p>
                            </div>
                        </div>

                        <div class="pe-rhythm-card {% if dto.employeeCount == '50-249' %}active{% endif %}"
                             data-action="click->recruteur#selectCount"
                             data-recruteur-target="countPill"
                             data-count-value="50-249"
                             data-count-label="50-249 collaborateurs">
                            <img src="{{ asset(dto.employeeCount == '50-249' ? 'icons/radio_checked.svg' : 'icons/radio_unchecked.svg') }}" alt="" width="18" height="18" class="pe-rhythm-radio-icon">
                            <div class="pe-rhythm-card-content">
                                <p class="pe-rhythm-title">50 – 249 collaborateurs</p>
                                <p class="pe-rhythm-desc">Scale-up &amp; ETI • Pôle technique structuré</p>
                            </div>
                        </div>

                        <div class="pe-rhythm-card {% if dto.employeeCount == '250+' %}active{% endif %}"
                             data-action="click->recruteur#selectCount"
                             data-recruteur-target="countPill"
                             data-count-value="250+"
                             data-count-label="250+ collaborateurs">
                            <img src="{{ asset(dto.employeeCount == '250+' ? 'icons/radio_checked.svg' : 'icons/radio_unchecked.svg') }}" alt="" width="18" height="18" class="pe-rhythm-radio-icon">
                            <div class="pe-rhythm-card-content">
                                <p class="pe-rhythm-title">250+ collaborateurs</p>
                                <p class="pe-rhythm-desc">Grand Groupe • Programmes alternance d'envergure</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            {# -----------------------------------------------------------------
               CARD 3: Présentation & Culture d'Entreprise (Étape 3 sur 3)
               ----------------------------------------------------------------- #}
            <section class="pe-card">
                <div class="pe-card-header">
                    <div class="pe-card-title-wrap">
                        <img src="{{ asset('icons/briefcase_doc.svg') }}" alt="" width="20" height="20">
                        <h2 class="pe-card-title">Présentation &amp; Marque Employeur</h2>
                    </div>
                    <span class="pe-card-step-badge">Étape 3 sur 3</span>
                </div>

                <div class="pe-form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <label class="pe-label">Pitch de présentation (affiché en premier sur votre deck de swipe entreprise)</label>
                        <span class="pe-card-step-badge" data-recruteur-target="charCount">0 / 500</span>
                    </div>
                    {{ form_widget(form.shortPresentation, {
                        'attr': {
                            'class': 'pe-textarea',
                            'rows': 4,
                            'placeholder': 'Décrivez la mission de votre entreprise, vos valeurs, et ce que vous proposez aux alternants...',
                            'data-recruteur-target': 'bioInput',
                            'data-action': 'input->recruteur#updateBio'
                        }
                    }) }}
                    {{ form_errors(form.shortPresentation) }}
                </div>
            </section>

        </div>

        {# =====================================================================
           RIGHT COLUMN: APERÇU CARTE ENTREPRISE EN DIRECT (5 COLS)
           ===================================================================== #}
        <aside class="pe-deck-col">
            
            <div class="pe-deck-header">
                <div class="pe-deck-title-wrap">
                    <span class="pe-deck-live-dot"></span>
                    <h3 class="pe-deck-title">Aperçu Carte Entreprise en Direct</h3>
                </div>
                <span class="pe-deck-badge-sub">Format Swipe Deck</span>
            </div>

            {# Live Company Deck Card #}
            <div class="pe-live-swipe-card">
                <div class="pe-live-card-photo-box">
                    {% set cardPhoto = dto.logoUrl ? dto.logoUrl : asset('images/company_logo.jpeg') %}
                    <img src="{{ cardPhoto }}" alt="" class="pe-live-card-photo" data-recruteur-target="liveCardPhoto" onerror="this.src='{{ asset('images/company_logo.jpeg') }}';">
                    <div class="pe-live-top-badges">
                        <span class="pe-live-badge-fit">✨ Recruteur Vérifié</span>
                        <span class="pe-live-badge-dispo">
                            <span class="pe-live-badge-dot"></span>
                            <span data-recruteur-target="previewCount">{{ dto.employeeCount }} collaborateurs</span>
                        </span>
                    </div>

                    <div class="pe-live-hero-overlay">
                        <h4 class="pe-live-name-headline">
                            <span data-recruteur-target="previewName">{{ dto.companyName ?: 'Mon Entreprise' }}</span>
                        </h4>
                        <p class="pe-live-headline-sub">🏢 <span data-recruteur-target="previewSector">{{ dto.sector ?: 'Secteur d\'activité' }}</span></p>
                    </div>
                </div>

                <div class="pe-live-card-content">
                    <div class="pe-live-rhythm-strip">
                        <div class="pe-live-rhythm-left">
                            <img src="{{ asset('icons/briefcase_doc.svg') }}" alt="" width="14" height="14">
                            <span>Secteur : <strong data-recruteur-target="previewSector">{{ dto.sector ?: 'Secteur d\'activité' }}</strong></span>
                        </div>
                        <span class="pe-live-duration-pill" data-recruteur-target="previewCount">
                            {{ dto.employeeCount }} collab.
                        </span>
                    </div>

                    <div class="pe-live-pitch-section">
                        <p class="pe-live-pitch-label">PITCH ENTREPRISE &amp; CULTURE</p>
                        <p class="pe-live-pitch-quote" data-recruteur-target="previewBio">
                            "{{ dto.shortPresentation }}"
                        </p>
                    </div>

                    <div class="pe-live-actions-row">
                        <button type="button" class="pe-live-action-btn" title="Passer">
                            <img src="{{ asset('icons/pass.svg') }}" alt="" width="16" height="16">
                        </button>
                        <button type="button" class="pe-live-action-btn red" title="Liker">
                            <img src="{{ asset('icons/heart.svg') }}" alt="" width="20" height="20">
                        </button>
                        <button type="button" class="pe-live-action-btn blue" title="Contacter">
                            <img src="{{ asset('icons/send.svg') }}" alt="" width="16" height="16">
                        </button>
                    </div>
                </div>
            </div>

            {# Publication Settings Card #}
            <div class="pe-pub-card">
                <h3 class="pe-pub-title">Paramètres de vitrine</h3>

                <div class="pe-pub-toggle-row">
                    <div class="pe-pub-toggle-texts">
                        <p class="pe-pub-status-main">Statut : {% if dto.isPublic %}Profil Entreprise Actif &amp; Visible{% else %}Profil Privé{% endif %}</p>
                        <p class="pe-pub-status-sub">{% if dto.isPublic %}Votre profil entreprise apparaît dans le flux de découverte des alternants{% else %}Votre entreprise est masquée des alternants{% endif %}</p>
                    </div>
                    <label class="pe-switch">
                        {{ form_widget(form.isPublic) }}
                        <span class="pe-slider"></span>
                    </label>
                </div>

                <button type="button"
                        class="pe-btn-pause"
                        data-action="click->recruteur#togglePause"
                        data-recruteur-target="pauseBtn">
                    <img src="{{ asset('icons/pause_icon.svg') }}" alt="" width="14" height="14">
                    <span data-recruteur-target="pauseBtnText">
                        {% if dto.isPaused %}
                            ▶ Réactiver mon profil entreprise (Reprendre la visibilité)
                        {% else %}
                            Mettre en pause mon profil (Recrutements clôturés)
                        {% endif %}
                    </span>
                </button>

                <button type="submit" class="pe-btn-save">
                    <img src="{{ asset('icons/save_disk.svg') }}" alt="" width="16" height="16">
                    <span>Enregistrer le profil</span>
                </button>
            </div>

        </aside>

    {{ form_end(form) }}
</div>

{# =========================================================================
   FOOTER BAR
   ========================================================================= #}
<footer class="pe-footer-bar">
    <div class="pe-footer-brand-copy">
        <span class="pe-footer-brand">TinderNance</span>
        <span>© 2025 Plateforme intelligente de recrutement en alternance.</span>
    </div>
    <div class="pe-footer-links">
        <a href="#" class="pe-footer-link">Mentions légales</a>
        <a href="#" class="pe-footer-link">Protection des données</a>
        <a href="#" class="pe-footer-link">Aide &amp; FAQ</a>
    </div>
</footer>
{% endblock %}
