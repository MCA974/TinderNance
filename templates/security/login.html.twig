{% extends 'base.html.twig' %}

{% block title %}Connexion - Tindernance{% endblock %}

{% block body %}
<div class="glass-auth-card">
    <div class="auth-header">
        <div class="auth-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <span>Bon retour parmi nous</span>
        </div>
        <h1 class="auth-title">Connexion</h1>
        <p class="auth-subtitle">Retrouvez vos opportunités et échangez avec vos matchs.</p>
    </div>

    {% if error %}
        <div class="alert alert-danger">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
            </svg>
            <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        </div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <div class="form-group">
            <label for="username" class="form-label">Adresse email</label>
            <input type="email" 
                   value="{{ last_username }}" 
                   name="_username" 
                   id="username" 
                   class="form-control" 
                   autocomplete="email" 
                   placeholder="ex : alex.dupont@email.com" 
                   required 
                   autofocus>
        </div>

        <div class="form-group">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.45rem;">
                <label for="password" class="form-label" style="margin-bottom: 0;">Mot de passe</label>
                <a href="#" style="font-size: 0.8rem; color: var(--color-primary-indigo); text-decoration: none; font-weight: 600;">Oublié ?</a>
            </div>
            <input type="password" 
                   name="_password" 
                   id="password" 
                   class="form-control" 
                   autocomplete="current-password" 
                   placeholder="••••••••" 
                   required>
        </div>

        <div class="form-check" style="justify-content: space-between;">
            <label class="form-check-label" style="display: flex; align-items: center; gap: 0.5rem;">
                <input type="checkbox" name="_remember_me">
                <span>Se souvenir de moi</span>
            </label>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button class="btn btn-primary" type="submit">
            <span>Se connecter</span>
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
        </button>
    </form>

    <div class="match-hint-pill">
        <span style="color: var(--color-secondary);">🔥</span>
        <span>Rejoignez des milliers d'alternants et entreprises en direct</span>
    </div>

    <div class="auth-footer">
        <span>Pas encore inscrit sur Tindernance ?</span>
        <a href="{{ path('app_register') }}">Créer un compte</a>
    </div>
</div>
{% endblock %}
