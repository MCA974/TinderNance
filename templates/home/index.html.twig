{% extends 'base.html.twig' %}

{% block title %}Accueil - Tindernance{% endblock %}

{% block body %}
<div class="glass-auth-card" style="max-width: 640px; text-align: center;">
    <div class="auth-header" style="margin-bottom: 1.5rem;">
        <div class="auth-badge">
            <span>🔥 Match & Alternance</span>
        </div>
        <h1 class="auth-title">Bienvenue sur Tindernance</h1>
        <p class="auth-subtitle">
            L'alternance nouvelle génération : trouvez votre futur partenaire professionnel au coup de cœur et aux compétences.
        </p>
    </div>

    {% if user %}
        <div style="background: rgba(99, 102, 241, 0.08); border-radius: var(--radius-md); padding: 1.5rem; margin-bottom: 2rem;">
            <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">
                {{ user.role and user.role.value == 'STUDENT' ? '🎓' : '🏢' }}
            </div>
            <h2 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; margin-bottom: 0.25rem;">
                Ravi de vous voir, {{ user.firstName }} {{ user.lastName }} !
            </h2>
            <p style="color: var(--color-text-muted); font-size: 0.9rem;">
                Connecté en tant que <strong>{{ user.role and user.role.value == 'STUDENT' ? 'Étudiant(e)' : 'Entreprise / Recruteur' }}</strong> ({{ user.email }}).
            </p>
        </div>

        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            {% if user.role and user.role.value == 'STUDENT' %}
                <a href="{{ path('app_profil_etudiant') }}" class="btn btn-primary" style="width: auto;">
                    <span>Voir mon Profil Étudiant</span>
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                </a>
            {% elseif user.role and user.role.value == 'COMPANY' %}
                <a href="{{ path('app_recruteur_profil') }}" class="btn btn-primary" style="width: auto;">
                    <span>Espace Recruteur & Offres</span>
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                </a>
            {% endif %}
            <a href="{{ path('app_logout') }}" class="btn btn-ghost" style="width: auto;">
                Se déconnecter
            </a>
        </div>
    {% else %}
        <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1.5rem;">
            <a href="{{ path('app_register') }}" class="btn btn-primary">
                <span>Créer un compte</span>
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
            </a>
            <a href="{{ path('app_login') }}" class="btn btn-ghost">
                Déjà membre ? Se connecter
            </a>
        </div>
    {% endif %}

    <div class="match-hint-pill" style="margin-top: 2rem;">
        <span>🚀</span>
        <span>Mobile-first, fluide et transparent pour étudiants et entreprises.</span>
    </div>
</div>
{% endblock %}
