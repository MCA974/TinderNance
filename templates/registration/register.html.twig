{% extends 'base.html.twig' %}

{% block title %}Inscription - Tindernance{% endblock %}

{% block body %}
<div class="glass-auth-card">
    <div class="auth-header">
        <div class="auth-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <span>Nouveau compte</span>
        </div>
        <h1 class="auth-title">Inscription</h1>
        <p class="auth-subtitle">Match direct entre étudiants motivés et entreprises qui recrutent.</p>
    </div>

    {{ form_start(registrationForm, {'attr': {'class': 'auth-form'}}) }}

        {# Segmented Role Selector #}
        <div class="role-segmented-group">
            <span class="role-segmented-label">{{ form_label(registrationForm.role) }}</span>
            <div class="role-segmented-control">
                {% for child in registrationForm.role %}
                    <label class="role-option">
                        {{ form_widget(child) }}
                        <span class="role-card-label">
                            {% if child.vars.value == 'STUDENT' %}
                                <span>🎓</span>
                            {% else %}
                                <span>🏢</span>
                            {% endif %}
                            <span>{{ child.vars.label }}</span>
                        </span>
                    </label>
                {% endfor %}
            </div>
            {{ form_errors(registrationForm.role) }}
        </div>

        {# First Name & Last Name in 2 columns #}
        <div class="form-row-2">
            <div class="form-group">
                {{ form_label(registrationForm.firstName, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(registrationForm.firstName, {'attr': {'class': 'form-control' ~ (form_errors(registrationForm.firstName) ? ' is-invalid' : '')}}) }}
                {{ form_errors(registrationForm.firstName) }}
            </div>
            <div class="form-group">
                {{ form_label(registrationForm.lastName, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(registrationForm.lastName, {'attr': {'class': 'form-control' ~ (form_errors(registrationForm.lastName) ? ' is-invalid' : '')}}) }}
                {{ form_errors(registrationForm.lastName) }}
            </div>
        </div>

        {# Email #}
        <div class="form-group">
            {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control' ~ (form_errors(registrationForm.email) ? ' is-invalid' : '')}}) }}
            {{ form_errors(registrationForm.email) }}
        </div>

        {# Password #}
        <div class="form-group">
            {{ form_label(registrationForm.plainPassword, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control' ~ (form_errors(registrationForm.plainPassword) ? ' is-invalid' : '')}}) }}
            {{ form_errors(registrationForm.plainPassword) }}
        </div>

        {# Terms & Conditions Checkbox #}
        <div class="form-check">
            {{ form_widget(registrationForm.agreeTerms) }}
            <label for="{{ registrationForm.agreeTerms.vars.id }}" class="form-check-label">
                J'accepte les <a href="#">conditions générales</a> et la <a href="#">politique de confidentialité</a>.
            </label>
        </div>
        {{ form_errors(registrationForm.agreeTerms) }}

        <button type="submit" class="btn btn-primary">
            <span>Créer mon compte</span>
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
        </button>

    {{ form_end(registrationForm) }}

    <div class="match-hint-pill">
        <span>⚡</span>
        <span>Accédez instantanément aux meilleures offres et profils</span>
    </div>

    <div class="auth-footer">
        <span>Vous avez déjà un compte ?</span>
        <a href="{{ path('app_login') }}">Se connecter</a>
    </div>
</div>
{% endblock %}
