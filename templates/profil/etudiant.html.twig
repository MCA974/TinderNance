{% extends 'base.html.twig' %}

{% block title %}Mon Profil d'Alternance - TinderNance{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/profil_etudiant.css') }}">
{% endblock %}

{% block body %}
{# =========================================================================
   TOP NAVIGATION BAR
   ========================================================================= #}
<nav class="pe-navbar">
    <a href="{{ path('app_home') }}" class="pe-nav-brand">
        <img src="{{ asset('icons/logo.svg') }}" alt="" width="24" height="24">
        <span>TinderNance</span>
    </a>

    <div class="pe-nav-links">
        <a href="#" class="pe-nav-link">Découverte</a>
        <a href="#" class="pe-nav-link">Candidats</a>
        <a href="#" class="pe-nav-link">
            <span>Matches & Messages</span>
            <span class="pe-badge-count">5</span>
        </a>
        <a href="{{ path('app_profil_etudiant') }}" class="pe-nav-link active">Mon Profil & Vitrine</a>
    </div>

    <div class="pe-nav-user-area">
        <button type="button" class="pe-nav-bell-btn" title="Notifications">
            <img src="{{ asset('icons/bell.svg') }}" alt="" width="18" height="18">
            <span class="pe-nav-bell-badge"></span>
        </button>

        <div class="pe-nav-user-pill">
            {% set navAvatar = dto.photoUrl ? dto.photoUrl : asset('images/nav_avatar.png') %}
            <img src="{{ navAvatar }}" alt="Avatar" class="pe-nav-user-avatar">
            <div class="pe-nav-user-meta">
                <p class="pe-nav-user-name">{{ dto.fullName }}</p>
                <p class="pe-nav-user-role">Alternant Dev</p>
            </div>
        </div>
    </div>
</nav>

{# =========================================================================
   MAIN CONTENT
   ========================================================================= #}
<div class="pe-page-body" data-node-id="71:1528">
    
    {# Flash messages feedback #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="pe-alert pe-alert-{{ label }}">
                <span>{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}

    {# Header Row with View Switcher #}
    <header class="pe-header-row" data-node-id="71:1532">
        <div class="pe-header-left">
            <div class="pe-session-tag">
                <span class="pe-session-dot"></span>
                <span>ESPACE CANDIDAT • SESSION ACTIVE</span>
            </div>
            <h1 class="pe-header-title">Mon Profil d'Alternance</h1>
        </div>

        <div class="pe-view-switcher" data-node-id="71:1541">
            <button type="button" class="pe-view-btn active" data-action="click->profil#switchView" data-profil-target="viewBtn">
                <img src="{{ asset('icons/edit_pen.svg') }}" alt="" width="14" height="14">
                <span>Éditer en tant qu'Alternant</span>
            </button>
            <button type="button" class="pe-view-btn" data-action="click->profil#switchView" data-profil-target="viewBtn">
                <img src="{{ asset('icons/preview_eye.svg') }}" alt="" width="16" height="12">
                <span>Aperçu public Entreprise</span>
            </button>
        </div>
    </header>

    {# Formulaire interactif relié au contrôleur Stimulus #}
    {{ form_start(form, {'attr': {'class': 'pe-split-grid', 'data-controller': 'profil', 'data-node-id': '71:1578'}}) }}
        
        {# Champs cachés pour le rythme, la durée et l'état de pause #}
        {{ form_widget(form.alternationRhythm, {'attr': {'data-profil-target': 'rhythmHiddenInput'}}) }}
        {{ form_widget(form.contractDuration, {'attr': {'data-profil-target': 'durationHiddenInput'}}) }}
        {{ form_widget(form.isPaused, {'attr': {'data-profil-target': 'isPausedInput'}}) }}

        {# Input de fichier caché pour la simulation d'upload de photo #}
        <input type="file" accept="image/*" class="d-none" style="display: none;" data-profil-target="fileInput" data-action="change->profil#onPhotoSelected">

        {# =====================================================================
           LEFT COLUMN: FORMULAIRE INTERACTIF (7 COLS)
           ===================================================================== #}
        <div class="pe-form-col" data-node-id="71:1579">
            
            {# -----------------------------------------------------------------
               CARD 1: Identité & Coordonnées (Étape 1 sur 4)
               ----------------------------------------------------------------- #}
            <section class="pe-card" data-node-id="71:1580">
                <div class="pe-card-header">
                    <div class="pe-card-title-wrap">
                        <img src="{{ asset('icons/identity_user.svg') }}" alt="" width="20" height="20">
                        <h2 class="pe-card-title">Identité & Coordonnées</h2>
                    </div>
                    <span class="pe-card-step-badge">Étape 1 sur 4</span>
                </div>

                <div class="pe-identity-profile-row">
                    <div class="pe-avatar-box">
                        {% set candidateAvatar = dto.photoUrl ? dto.photoUrl : asset('images/lucas_avatar.png') %}
                        <img src="{{ candidateAvatar }}" alt="Avatar" class="pe-avatar-photo" data-profil-target="avatarImg">
                        <button type="button" class="pe-avatar-change-btn" title="Changer la photo" data-action="click->profil#triggerUpload">
                            <img src="{{ asset('icons/camera.svg') }}" alt="" width="13" height="12">
                        </button>
                    </div>

                    <div class="pe-identity-profile-info">
                        <div class="pe-identity-name-row">
                            <h3 class="pe-identity-name" data-profil-target="liveName">{{ dto.fullName }}</h3>
                            <img src="{{ asset('icons/verified_check.svg') }}" alt="Vérifié" width="18" height="18">
                        </div>
                        <p class="pe-identity-status-desc">
                            Recherche active d'un contrat de professionnalisation ou d'apprentissage.
                        </p>
                        <div class="pe-identity-actions">
                            <button type="button" class="pe-btn-mini pe-btn-mini-primary" data-action="click->profil#triggerUpload">Changer la photo</button>
                            <button type="button" class="pe-btn-mini pe-btn-mini-muted">Supprimer</button>
                        </div>
                    </div>
                </div>

                <div class="pe-fields-row">
                    <div class="pe-form-group">
                        <label class="pe-label">Nom complet</label>
                        {{ form_widget(form.fullName, {
                            'attr': {
                                'class': 'pe-input',
                                'data-profil-target': 'fullNameInput',
                                'data-action': 'input->profil#updateName'
                            }
                        }) }}
                        {{ form_errors(form.fullName) }}
                    </div>
                    <div class="pe-form-group">
                        <label class="pe-label">Email universitaire ou pro</label>
                        {{ form_widget(form.email, {
                            'attr': {
                                'class': 'pe-input'
                            }
                        }) }}
                        {{ form_errors(form.email) }}
                    </div>
                </div>

                <div class="pe-fields-row">
                    <div class="pe-form-group">
                        <label class="pe-label">Zone géographique de mobilité</label>
                        <div class="pe-input-icon-wrap">
                            <img src="{{ asset('icons/pin.svg') }}" alt="" width="14" height="14" class="pe-input-icon">
                            {{ form_widget(form.searchRegion, {
                                'attr': {
                                    'class': 'pe-input pe-input-with-icon'
                                }
                            }) }}
                        </div>
                    </div>
                    <div class="pe-form-group">
                        <label class="pe-label">Rayon max (km)</label>
                        {{ form_widget(form.searchRadius, {
                            'attr': {
                                'class': 'pe-input'
                            }
                        }) }}
                    </div>
                </div>
            </section>

            {# -----------------------------------------------------------------
               CARD 2: École & Statut CFA (Étape 2 sur 4)
               ----------------------------------------------------------------- #}
            <section class="pe-card" data-node-id="71:1621">
                <div class="pe-card-header">
                    <div class="pe-card-title-wrap">
                        <img src="{{ asset('icons/school_cap.svg') }}" alt="" width="20" height="20">
                        <h2 class="pe-card-title">École & Statut CFA</h2>
                    </div>
                    <span class="pe-card-step-badge">Étape 2 sur 4</span>
                </div>

                <div class="pe-school-banner">
                    <div class="pe-school-banner-left">
                        <div class="pe-school-logo-square">
                            <span>H</span>
                        </div>
                        <div class="pe-school-texts">
                            <p class="pe-school-title">{{ dto.schoolName }}</p>
                            <p class="pe-school-degree">{{ dto.obtainedDiploma }}</p>
                            {{ form_widget(form.schoolName, {'attr': {'style': 'display:none;'}}) }}
                            {{ form_widget(form.obtainedDiploma, {'attr': {'style': 'display:none;'}}) }}
                        </div>
                    </div>

                    <div class="pe-status-admis-badge">
                        <img src="{{ asset('icons/checkmark.svg') }}" alt="" width="12" height="10">
                        <span>Inscrit & Admis</span>
                    </div>
                </div>

                <div class="pe-form-group">
                    <label class="pe-label">Organisme de formation / Campus</label>
                    {{ form_widget(form.schoolCampus, {'attr': {'class': 'pe-input'}}) }}
                </div>
            </section>

            {# -----------------------------------------------------------------
               CARD 3: Rythme & Calendrier Souhaité (Étape 3 sur 4)
               ----------------------------------------------------------------- #}
            <section class="pe-card" data-node-id="71:1645">
                <div class="pe-card-header">
                    <div class="pe-card-title-wrap">
                        <img src="{{ asset('icons/calendar_clock.svg') }}" alt="" width="20" height="20">
                        <h2 class="pe-card-title">Rythme & Calendrier Souhaité</h2>
                    </div>
                    <span class="pe-card-step-badge">Étape 3 sur 4</span>
                </div>

                <div class="pe-form-group">
                    <label class="pe-label">Sélectionnez la cadence imposée par votre école :</label>
                    <div class="pe-rhythm-grid">
                        <div class="pe-rhythm-card {% if dto.alternationRhythm == '3j Entreprise / 2j École' %}active{% endif %}"
                             data-action="click->profil#selectRhythm"
                             data-profil-target="rhythmCard"
                             data-rhythm-value="3j Entreprise / 2j École">
                            <img src="{{ asset(dto.alternationRhythm == '3j Entreprise / 2j École' ? 'icons/radio_checked.svg' : 'icons/radio_unchecked.svg') }}" alt="" width="18" height="18" class="pe-rhythm-radio-icon">
                            <div class="pe-rhythm-card-content">
                                <p class="pe-rhythm-title">3j Entreprise / 2j École</p>
                                <p class="pe-rhythm-desc">Lun-Mar-Mer en poste • Jeu-Ven au CFA</p>
                            </div>
                        </div>

                        <div class="pe-rhythm-card {% if dto.alternationRhythm == '1 semaine CFA / 3 sem. Entreprise' %}active{% endif %}"
                             data-action="click->profil#selectRhythm"
                             data-profil-target="rhythmCard"
                             data-rhythm-value="1 semaine CFA / 3 sem. Entreprise">
                            <img src="{{ asset(dto.alternationRhythm == '1 semaine CFA / 3 sem. Entreprise' ? 'icons/radio_checked.svg' : 'icons/radio_unchecked.svg') }}" alt="" width="18" height="18" class="pe-rhythm-radio-icon">
                            <div class="pe-rhythm-card-content">
                                <p class="pe-rhythm-title">1 semaine CFA / 3 sem. Entreprise</p>
                                <p class="pe-rhythm-desc">Immersion longue période</p>
                            </div>
                        </div>

                        <div class="pe-rhythm-card {% if dto.alternationRhythm == '2 semaines / 2 semaines' %}active{% endif %}"
                             data-action="click->profil#selectRhythm"
                             data-profil-target="rhythmCard"
                             data-rhythm-value="2 semaines / 2 semaines">
                            <img src="{{ asset(dto.alternationRhythm == '2 semaines / 2 semaines' ? 'icons/radio_checked.svg' : 'icons/radio_unchecked.svg') }}" alt="" width="18" height="18" class="pe-rhythm-radio-icon">
                            <div class="pe-rhythm-card-content">
                                <p class="pe-rhythm-title">2 semaines / 2 semaines</p>
                                <p class="pe-rhythm-desc">Équilibré cours magistraux & missions</p>
                            </div>
                        </div>

                        <div class="pe-rhythm-card {% if dto.alternationRhythm == 'Temps plein modulable' %}active{% endif %}"
                             data-action="click->profil#selectRhythm"
                             data-profil-target="rhythmCard"
                             data-rhythm-value="Temps plein modulable">
                            <img src="{{ asset(dto.alternationRhythm == 'Temps plein modulable' ? 'icons/radio_checked.svg' : 'icons/radio_unchecked.svg') }}" alt="" width="18" height="18" class="pe-rhythm-radio-icon">
                            <div class="pe-rhythm-card-content">
                                <p class="pe-rhythm-title">Temps plein modulable</p>
                                <p class="pe-rhythm-desc">Projets finaux en distanciel</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="pe-fields-row">
                    <div class="pe-form-group">
                        <label class="pe-label">Durée du contrat visée</label>
                        <div class="pe-pills-selector">
                            <button type="button"
                                    class="pe-pill-option {% if dto.contractDuration == '1_AN' or dto.contractDuration == '12 mois' %}active{% endif %}"
                                    data-action="click->profil#selectDuration"
                                    data-profil-target="durationPill"
                                    data-duration-value="12 Mois">
                                12 mois
                            </button>
                            <button type="button"
                                    class="pe-pill-option {% if dto.contractDuration == '2_ANS' or dto.contractDuration == '24 mois' %}active{% endif %}"
                                    data-action="click->profil#selectDuration"
                                    data-profil-target="durationPill"
                                    data-duration-value="24 Mois">
                                24 mois
                            </button>
                            <button type="button"
                                    class="pe-pill-option {% if dto.contractDuration == '3_ANS' or dto.contractDuration == '36 mois' %}active{% endif %}"
                                    data-action="click->profil#selectDuration"
                                    data-profil-target="durationPill"
                                    data-duration-value="36 Mois">
                                36 mois
                            </button>
                        </div>
                    </div>

                    <div class="pe-form-group">
                        <label class="pe-label">Date de démarrage souhaitée</label>
                        <div class="pe-input-icon-wrap">
                            <img src="{{ asset('icons/calendar_input.svg') }}" alt="" width="16" height="16" class="pe-input-icon">
                            {{ form_widget(form.desiredStartDate, {
                                'attr': {
                                    'class': 'pe-input pe-input-with-icon',
                                    'placeholder': 'JJ/MM/AAAA'
                                }
                            }) }}
                        </div>
                    </div>
                </div>
            </section>

            {# -----------------------------------------------------------------
               CARD 4: Compétences & Dossier de Candidature (Étape 4 sur 4)
               ----------------------------------------------------------------- #}
            <section class="pe-card" data-node-id="71:1688">
                <div class="pe-card-header">
                    <div class="pe-card-title-wrap">
                        <img src="{{ asset('icons/briefcase_doc.svg') }}" alt="" width="20" height="20">
                        <h2 class="pe-card-title">Compétences & Dossier de Candidature</h2>
                    </div>
                    <span class="pe-card-step-badge">Étape 4 sur 4</span>
                </div>

                <div class="pe-form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <label class="pe-label">Pitch d'accroche (visible en premier sur votre deck de swipe)</label>
                        <span class="pe-card-step-badge" data-profil-target="charCount">142 / 290</span>
                    </div>
                    {{ form_widget(form.bio, {
                        'attr': {
                            'class': 'pe-textarea',
                            'data-profil-target': 'bioInput',
                            'data-action': 'input->profil#updateBio'
                        }
                    }) }}
                    {{ form_errors(form.bio) }}
                </div>

                <div class="pe-form-group">
                    <label class="pe-label">Curriculum Vitae (PDF optimisé ATS)</label>
                    <div class="pe-cv-card">
                        <div class="pe-cv-card-left">
                            <div class="pe-cv-icon-red">
                                <img src="{{ asset('icons/pdf_icon.svg') }}" alt="PDF" width="18" height="20">
                            </div>
                            <div class="pe-cv-meta">
                                <p class="pe-cv-filename">
                                    {{ dto.cvUrl ? dto.cvUrl|split('/')|last : 'CV_Lucas_Moreau_DevFullstack_2025.pdf' }}
                                </p>
                                <p class="pe-cv-sub">
                                    <span>1.4 Mo • Mis à jour il y a 3 jours</span>
                                    <span class="pe-cv-badge-verified">✓ Contrôlé AlternMatch</span>
                                </p>
                            </div>
                        </div>

                        <div class="pe-cv-actions">
                            <a href="{{ dto.cvUrl ? dto.cvUrl : '#' }}" target="_blank" rel="noopener noreferrer" class="pe-icon-btn" title="Télécharger le CV">
                                <img src="{{ asset('icons/download_cv.svg') }}" alt="Télécharger" width="16" height="16">
                            </a>
                            <button type="button" class="pe-icon-btn" title="Remplacer le fichier" data-action="click->profil#triggerUpload">
                                <img src="{{ asset('icons/refresh_cv.svg') }}" alt="Remplacer" width="16" height="16">
                            </button>
                        </div>
                    </div>
                </div>
            </section>

        </div>

        {# =====================================================================
           RIGHT COLUMN: APERÇU CARTE RECRUTEUR & PUBLICATION (5 COLS)
           ===================================================================== #}
        <aside class="pe-deck-col">
            
            <div class="pe-deck-header">
                <div class="pe-deck-title-wrap">
                    <span class="pe-deck-live-dot"></span>
                    <h3 class="pe-deck-title">Aperçu Carte Recruteur en Direct</h3>
                </div>
                <span class="pe-deck-badge-sub">Format Swipe Deck</span>
            </div>

            {# Live Recruiter Deck Card #}
            <div class="pe-live-swipe-card" data-node-id="71:1750">
                <div class="pe-live-card-photo-box">
                    <img src="{{ asset('images/recruiter_preview.png') }}" alt="" class="pe-live-card-photo" data-profil-target="liveCardPhoto">
                    <div class="pe-live-top-badges">
                        <span class="pe-live-badge-fit">✨ Match Score : 96%</span>
                        <span class="pe-live-badge-dispo">
                            <span class="pe-live-badge-dot"></span>
                            <span>Disponible Sept. 25</span>
                        </span>
                    </div>

                    <div class="pe-live-hero-overlay">
                        <h4 class="pe-live-name-headline">
                            <span data-profil-target="previewName">{{ dto.fullName|split(' ')|first }}, 22</span>
                            <span style="font-size: 16px; font-weight: 600;">Dev Fullstack</span>
                        </h4>
                        <p class="pe-live-headline-sub">🎓 HÉTIC • Mastère Tech Lead (Bac +5)</p>
                    </div>
                </div>

                <div class="pe-live-card-content">
                    <div class="pe-live-rhythm-strip">
                        <div class="pe-live-rhythm-left">
                            <img src="{{ asset('icons/calendar_rythme.svg') }}" alt="" width="14" height="14">
                            <span data-profil-target="previewRhythm">Rythme : {{ dto.alternationRhythm }}</span>
                        </div>
                        <span class="pe-live-duration-pill" data-profil-target="previewDuration">
                            {% if dto.contractDuration == '1_AN' %}12 Mois{% elseif dto.contractDuration == '3_ANS' %}36 Mois{% else %}24 Mois{% endif %}
                        </span>
                    </div>

                    <div class="pe-live-pitch-section">
                        <p class="pe-live-pitch-label">PITCH RECRUTEUR</p>
                        <p class="pe-live-pitch-quote" data-profil-target="previewBio">
                            "{{ dto.bio }}"
                        </p>
                    </div>

                    <div class="pe-live-actions-row">
                        <button type="button" class="pe-live-action-btn" title="Passer">
                            <img src="{{ asset('icons/pass.svg') }}" alt="" width="16" height="16">
                        </button>
                        <button type="button" class="pe-live-action-btn red" title="Liker">
                            <img src="{{ asset('icons/heart.svg') }}" alt="" width="20" height="20">
                        </button>
                        <button type="button" class="pe-live-action-btn blue" title="Contacter">
                            <img src="{{ asset('icons/send.svg') }}" alt="" width="16" height="16">
                        </button>
                    </div>
                </div>
            </div>

            {# Publication Settings Card #}
            <div class="pe-pub-card" data-node-id="71:1780">
                <h3 class="pe-pub-title">Paramètres de publication</h3>

                <div class="pe-pub-toggle-row">
                    <div class="pe-pub-toggle-texts">
                        <p class="pe-pub-status-main">Statut : Profil Actif & Visible</p>
                        <p class="pe-pub-status-sub">Votre profil apparaît dans le flux de découverte des entreprises</p>
                    </div>
                    <label class="pe-switch">
                        {{ form_widget(form.isPublic) }}
                        <span class="pe-slider"></span>
                    </label>
                </div>

                <button type="button"
                        class="pe-btn-pause"
                        data-action="click->profil#togglePause"
                        data-profil-target="pauseBtn">
                    <img src="{{ asset('icons/pause_icon.svg') }}" alt="" width="14" height="14">
                    <span data-profil-target="pauseBtnText">
                        {% if dto.isPaused %}
                            ▶ Réactiver mon profil (Reprendre la visibilité)
                        {% else %}
                            Mettre en pause mon profil (Alternance trouvée)
                        {% endif %}
                    </span>
                </button>

                <button type="submit" class="pe-btn-save">
                    <img src="{{ asset('icons/save_disk.svg') }}" alt="" width="16" height="16">
                    <span>Enregistrer le profil</span>
                </button>
            </div>

        </aside>

    {{ form_end(form) }}
</div>

{# =========================================================================
   FOOTER BAR
   ========================================================================= #}
<footer class="pe-footer-bar">
    <div class="pe-footer-brand-copy">
        <span class="pe-footer-brand">TinderNance</span>
        <span>© 2025 Plateforme intelligente de recrutement en alternance.</span>
    </div>
    <div class="pe-footer-links">
        <a href="#" class="pe-footer-link">Mentions légales</a>
        <a href="#" class="pe-footer-link">Protection des données</a>
        <a href="#" class="pe-footer-link">Aide & FAQ</a>
    </div>
</footer>
{% endblock %}
